{
  "name": "AI Lineart Cleaner",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/ai-lineart-cleaner",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/ai-lineart-cleaner,type=bind",
  "forwardPorts": [8000],
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
